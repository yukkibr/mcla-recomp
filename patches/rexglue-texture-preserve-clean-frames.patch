 void TextureCache::BeginFrame() {
-  // In case there was a failure to create something in the previous frame, make
-  // sure bindings are reset so a new attempt will surely be made if the texture
-  // is requested again.
+  // The base code forces every texture binding to be re-fetched even when
+  // all prior operations succeeded. Keep the complete reset on any creation,
+  // residency or load failure, and for the original (OFF) mode. Watchers,
+  // fetch writes, explicit eviction and other existing reset sites still
+  // invalidate their own bindings independently.
+  if (texture_preserve_clean_frames_ && !texture_retry_needed_) {
+    return;
+  }
+  texture_retry_needed_ = false;
   ResetTextureBindings();
 }
 
