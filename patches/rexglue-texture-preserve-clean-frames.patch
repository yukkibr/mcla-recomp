 REXCVAR_DEFINE_BOOL(texture_watch_selective_stats, false, "GPU",
                     "Sparse statistics on selectively refreshed bindings")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
+// The stock SDK clears all texture bindings every BeginFrame, even when no
+// texture creation or upload has failed. That forces repeated descriptor,
+// guest layout and texture lookups for completely unchanged textures.
+// This option keeps valid bindings across frames, yet records any failure
+// and performs the same full reset on the next frame in that case.
+REXCVAR_DEFINE_BOOL(texture_preserve_clean_frame_bindings, false, "GPU",
+                    "Keep texture bindings across frames with no failed texture loads")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
 
 // An exact-key texture that is already in the per-device cache is valid
 // without repeating the host-extent normalization. Apply only without
