+void D3D12TextureCache::ReportTexturePoolProbe() {
+  if (!REXCVAR_GET(d3d12_texture_resource_pool_probe)) return;
+  using ProbeClock = std::chrono::steady_clock;
+  const auto now_us = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::microseconds>(
+          ProbeClock::now().time_since_epoch()).count());
+  if (!resource_pool_probe_last_us_) {
+    resource_pool_probe_last_us_ = now_us;
+    REXGPU_INFO("DX12 texture pool probe active: pool_limit_mb={} (cumulative counters)",
+                resource_pool_limit_bytes_ >> 20);
+    return;
+  }
+  if (now_us - resource_pool_probe_last_us_ < UINT64_C(10000000)) return;
+  resource_pool_probe_last_us_ = now_us;
+  REXGPU_INFO(
+      "DX12 texture pool probe: creations={} create_failures={} "
+      "create_total_ms={:.2f} create_peak_ms={:.2f} "
+      "recycle_attempts={} recycled={} reject_untracked={} "
+      "reject_busy={} reject_oversized={} reject_other={} "
+      "reuses={} misses={} desc_misses={} evictions={} "
+      "pool_entries={} pool_mb={:.2f} pool_peak_mb={:.2f}",
+      resource_pool_committed_creates_, resource_pool_committed_failures_,
+      double(resource_pool_committed_us_) / 1000.0,
+      double(resource_pool_committed_peak_us_) / 1000.0,
+      resource_pool_recycle_attempts_, resource_pool_recycle_stored_,
+      resource_pool_reject_untracked_, resource_pool_reject_gpu_busy_,
+      resource_pool_reject_oversized_, resource_pool_reject_other_,
+      resource_pool_hits_, resource_pool_misses_,
+      resource_pool_description_misses_, resource_pool_evictions_,
+      resource_pool_.size(), double(resource_pool_bytes_) / (1024.0 * 1024.0),
+      double(resource_pool_peak_bytes_) / (1024.0 * 1024.0));
 }
 
