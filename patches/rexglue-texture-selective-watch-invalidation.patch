+void TextureCache::ResetOnlyOutdatedTextureBindings() {
+  uint32_t dirty_bindings = 0;
+  uint32_t considered = 0;
+  for (size_t i = 0; i < texture_bindings_.size(); ++i) {
+    TextureBinding& binding = texture_bindings_[i];
+    if (!binding.key.is_valid) {
+      continue;
+    }
+    ++considered;
+    // The guest memory watches mark outdated bits before notifying the cache.
+    // An explicitly failed binding is also retried, as in the original
+    // ResetTextureBindings, rather than becoming permanently stuck.
+    bool dirty = (binding.texture && binding.texture->outdated_mask()) ||
+                 (binding.texture_signed && binding.texture_signed->outdated_mask()) ||
+                 (!binding.texture && !binding.texture_signed);
+    if (!dirty) {
+      continue;
+    }
+    const uint32_t index_bit = UINT32_C(1) << i;
+    binding.Reset();
+    dirty_bindings |= index_bit;
+  }
+  // Preserve all other binding descriptors, cached keys, signedness and
+  // residency. Changes will be resolved by the usual RequestTextures loop.
+  texture_bindings_in_sync_ &= ~dirty_bindings;
+  if (dirty_bindings) {
+    UpdateTextureBindingsImpl(dirty_bindings);
+  }
+  if (REXCVAR_GET(texture_watch_selective_stats)) {
+    struct Stats {
+      uint64_t events = 0, inspected = 0, refreshed = 0;
+    };
+    static thread_local Stats stats{};
+    ++stats.events;
+    stats.inspected += considered;
+    stats.refreshed += rex::bit_count(dirty_bindings);
+    if ((stats.events & UINT64_C(511)) == 0) {
+      REXGPU_INFO("Texture selective invalidation: {} events, {} bindings inspected, "
+                  "{} bindings refreshed vs. full reset (cumulative)",
+                  stats.events, stats.inspected, stats.refreshed);
+    }
+  }
+}
