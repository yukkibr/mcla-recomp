 namespace rex::graphics::d3d12 {
+
+// Optional lightweight CPU timing of the D3D12 GPU Commands thread. These
+// counts DO NOT measure hardware GPU execution time, do not synchronize GPU,
+// and never modify rendering or guest memory.
+namespace {
+enum class HitchPart : uint32_t {
+  kDraw,
+  kRenderTargets,
+  kPipeline,
+  kTextures,
+  kBindings,
+  kFence,
+  kSubmission,
+  kSwap,
+  kCount
+};
+constexpr size_t kHitchPartCount = size_t(HitchPart::kCount);
+using HitchClock = std::chrono::steady_clock;
+struct HitchFrame {
+  std::array<uint64_t, kHitchPartCount> us{};
+  std::array<uint64_t, kHitchPartCount> peak_us{};
+  std::array<uint64_t, kHitchPartCount> calls{};
+  uint64_t frame_count = 0;
+  HitchClock::time_point previous_swap{};
+  uint32_t frames_since_report = 0;
+};
+thread_local HitchFrame hitch_frame{};
+
+struct HitchScope {
+  HitchPart part;
+  bool enabled;
+  HitchClock::time_point start;
+  explicit HitchScope(HitchPart what) : part(what), enabled(REXCVAR_GET(d3d12_hitch_probe)) {
+    if (enabled) start = HitchClock::now();
+  }
+  ~HitchScope() {
+    if (!enabled) return;
+    const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+        HitchClock::now() - start).count();
+    const auto idx = size_t(part);
+    const uint64_t us = uint64_t(std::max<int64_t>(0, elapsed));
+    hitch_frame.us[idx] += us;
+    hitch_frame.peak_us[idx] = std::max(hitch_frame.peak_us[idx], us);
+    ++hitch_frame.calls[idx];
+  }
+};
+
+void HitchReportBeforeSwap() {
+  if (!REXCVAR_GET(d3d12_hitch_probe)) {
+    hitch_frame = {};
+    return;
+  }
+  auto now = HitchClock::now();
+  if (hitch_frame.previous_swap == HitchClock::time_point{}) {
+    hitch_frame.previous_swap = now;
+    return;
+  }
+  const auto interval_us = std::chrono::duration_cast<std::chrono::microseconds>(
+      now - hitch_frame.previous_swap).count();
+  hitch_frame.previous_swap = now;
+  const auto& sum = hitch_frame.us;
+  const auto& calls = hitch_frame.calls;
+  const auto& peak = hitch_frame.peak_us;
+  const auto get = [&](HitchPart p) { return double(sum[size_t(p)]) / 1000.0; };
+  const auto count = [&](HitchPart p) { return calls[size_t(p)]; };
+  ++hitch_frame.frames_since_report;
+  const bool hitch = interval_us >= 50000;
+  if (hitch || hitch_frame.frames_since_report >= 180) {
+    REXGPU_INFO(
+        "DX12 hitch probe: GPU-thread swap interval {:.1f}ms | draws {} "
+        "cpu {:.1f}ms (max single {:.2f}ms), rt {:.1f}ms, "
+        "pipeline {:.1f}ms, texture {:.1f}ms, bindings {:.1f}ms, "
+        "fence {:.1f}ms (max {:.1f}ms), submits {} cpu {:.1f}ms, "
+        "swap {:.1f}ms, overlap=yes",
+        double(interval_us) / 1000.0, count(HitchPart::kDraw), get(HitchPart::kDraw),
+        double(peak[size_t(HitchPart::kDraw)]) / 1000.0,
+        get(HitchPart::kRenderTargets), get(HitchPart::kPipeline),
+        get(HitchPart::kTextures), get(HitchPart::kBindings),
+        get(HitchPart::kFence), double(peak[size_t(HitchPart::kFence)]) / 1000.0,
+        count(HitchPart::kSubmission), get(HitchPart::kSubmission),
+        get(HitchPart::kSwap));
+    hitch_frame.frames_since_report = 0;
+  }
+  // Nested categories deliberately overlap (draw includes RT, pipeline,
+  // textures, bindings). Do not add all category times as a frame total.
+  hitch_frame.us.fill(0);
+  hitch_frame.peak_us.fill(0);
+  hitch_frame.calls.fill(0);
+}
