   COUNT_profile_set("gpu/texture_cache/request_textures_pending_range_count",
@@ -613,6 +623,7 @@
 #endif
   }
 
+  const auto stage_resident = stage_probe ? StageClock::now() : StageClock::time_point{};
   if (batched_shared_memory_request_succeeded) {
     for (const PendingTextureLoad& pending_load : pending_texture_loads) {
       CommitPreparedTextureLoad(pending_load);
@@ -624,8 +635,74 @@
       }
     }
   }
+  const auto stage_uploaded = stage_probe ? StageClock::now() : StageClock::time_point{};
   if (bindings_changed) {
     UpdateTextureBindingsImpl(bindings_changed);
+  }
+  if (stage_probe) {
+    const auto finished = StageClock::now();
+    const auto elapsed = [](StageClock::time_point a, StageClock::time_point b) {
+      return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(b - a).count());
+    };
+    const uint64_t prep_us = elapsed(stage_start, stage_prepared);
+    const uint64_t resident_us = elapsed(stage_prepared, stage_resident);
