   const auto& regs = register_file();
 
   if (texture_became_outdated_.exchange(false, std::memory_order_acquire)) {
@@ -585,6 +594,7 @@
     PROFILE_TEXTURE_UPLOAD_REQUESTS(static_cast<int64_t>(pending_texture_loads.size()));
   }
 #endif
+  const auto stage_prepared = stage_probe ? StageClock::now() : StageClock::time_point{};
   COUNT_profile_set("gpu/texture_cache/request_textures_pending_load_count",
