+    static thread_local StageStats totals{};
+    if (totals.started == StageClock::time_point{}) {
+      totals.started = stage_start;
+    }
+    ++totals.calls;
+    totals.prep_us += prep_us;
+    totals.resident_us += resident_us;
+    totals.upload_us += upload_us;
+    totals.bindings_us += bindings_us;
