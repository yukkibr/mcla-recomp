+          double(totals.resident_us) / 1000.0, double(totals.upload_us) / 1000.0,
+          double(totals.bindings_us) / 1000.0, totals.pending_loads,
+          totals.pending_ranges, totals.changed_bindings, totals.slow_calls,
+          double(totals.peak_call_us) / 1000.0);
+      totals = {};
+    }
   }
