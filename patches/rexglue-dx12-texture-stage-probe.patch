+            double(resident_us) / 1000.0, double(upload_us) / 1000.0,
+            double(bindings_us) / 1000.0, pending_texture_loads.size(),
+            pending_shared_memory_ranges.size(), bindings_changed != 0,
+            batched_shared_memory_request_succeeded);
+        ++totals.events;
+      }
+    }
+    if (finished - totals.started >= std::chrono::seconds(5)) {
+      REXLOG_INFO(
