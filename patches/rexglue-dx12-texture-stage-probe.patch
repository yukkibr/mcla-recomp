+    const uint64_t total_us = elapsed(stage_start, finished);
+    struct StageStats {
+      StageClock::time_point started{};
+      uint64_t calls = 0;
+      uint64_t prep_us = 0;
+      uint64_t resident_us = 0;
+      uint64_t upload_us = 0;
+      uint64_t bindings_us = 0;
+      uint64_t pending_loads = 0;
+      uint64_t pending_ranges = 0;
+      uint64_t changed_bindings = 0;
