+void D3D12TextureCache::RecycleTextureResource(
+    ID3D12Resource* resource, D3D12_RESOURCE_STATES state, uint64_t last_submission,
+    uint64_t bytes) {
+  // A cached resource may be reclaimed only when no queued GPU command
+  // references it. Never recycle untracked textures (submission 0).
+  if (!resource_pool_limit_bytes_ || !resource || !bytes ||
+      bytes > resource_pool_limit_bytes_ || !last_submission ||
+      last_submission > command_processor_.GetCompletedSubmission()) {
+    return;
+  }
+  while (!resource_pool_.empty() &&
+         resource_pool_bytes_ + bytes > resource_pool_limit_bytes_) {
+    resource_pool_bytes_ -= resource_pool_.front().bytes;
+    resource_pool_.erase(resource_pool_.begin());
+  }
+  PooledResource entry{};
+  entry.desc = resource->GetDesc();
+  entry.resource = resource;
+  entry.state = state;
+  entry.bytes = bytes;
+  resource_pool_.push_back(std::move(entry));
+  resource_pool_bytes_ += bytes;
+}
